# ═══════════════════════════════════════════════════════
# KEYSTATIC CMS - GitHub OAuth Authentication
# ═══════════════════════════════════════════════════════
# Required for the /keystatic admin panel on production Vercel.
# See setup guide below for how to get these values.

# Your GitHub OAuth App Client ID
KEYSTATIC_GITHUB_CLIENT_ID=your_github_client_id_here

# Your GitHub OAuth App Client Secret
KEYSTATIC_GITHUB_CLIENT_SECRET=your_github_client_secret_here

# A long random secret string (min 32 chars) for session signing
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEYSTATIC_SECRET=your_random_secret_here_min_32_chars

# ═══════════════════════════════════════════════════════
# PUBLIC VARIABLES (exposed to browser for OAuth flow)
# ═══════════════════════════════════════════════════════
PUBLIC_KEYSTATIC_GITHUB_CLIENT_ID=your_github_client_id_here
