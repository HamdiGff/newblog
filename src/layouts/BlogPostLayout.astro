---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagBadge from '../components/TagBadge.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SocialShare from '../components/SocialShare.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
  readingTime: string;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  prevPost?: { id: string; title: string };
  nextPost?: { id: string; title: string };
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  readingTime,
  headings = [],
  prevPost,
  nextPost,
} = Astro.props;

const currentUrl = Astro.url.href;
---

<BaseLayout title={title} description={description} image={heroImage} articleDate={pubDate}>
  <article class="max-w-2xl mx-auto">
    <!-- Back to blog navigation -->
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 text-xs font-mono text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors mb-8"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7" />
      </svg>
      Back to all posts
    </a>

    <!-- Header section -->
    <header class="mb-10 pb-8 border-b border-neutral-200 dark:border-neutral-800">
      <div class="flex items-center gap-2 text-xs mb-3">
        <FormattedDate date={pubDate} />
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span class="font-mono text-neutral-400 dark:text-neutral-500">{readingTime}</span>
        {updatedDate && (
          <>
            <span class="text-neutral-300 dark:text-neutral-700">•</span>
            <span class="font-mono text-neutral-400 dark:text-neutral-500">
              Updated: <FormattedDate date={updatedDate} />
            </span>
          </>
        )}
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-950 dark:text-white mb-4">
        {title}
      </h1>

      <p class="text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
        {description}
      </p>

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-5">
          {tags.map((tag) => (
            <TagBadge tag={tag} />
          ))}
        </div>
      )}
    </header>

    <!-- Table of Contents -->
    {headings.length > 0 && <TableOfContents headings={headings} />}

    <!-- Hero Image if any -->
    {heroImage && (
      <div class="my-8 rounded-xl overflow-hidden border border-neutral-200 dark:border-neutral-800">
        <img src={heroImage} alt={title} class="w-full object-cover" />
      </div>
    )}

    <!-- Markdown Content Body -->
    <div class="prose-content">
      <slot />
    </div>

    <!-- Social Share -->
    <div class="mt-12">
      <SocialShare title={title} url={currentUrl} />
    </div>

    <!-- Next / Prev Post Links -->
    {(prevPost || nextPost) && (
      <nav class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8 pt-8 border-t border-neutral-200 dark:border-neutral-800">
        {prevPost ? (
          <a
            href={`/blog/${prevPost.id}`}
            class="group p-4 rounded-lg border border-neutral-200 dark:border-neutral-800 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors"
          >
            <span class="text-[10px] font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500 block mb-1">
              ← Previous Post
            </span>
            <span class="text-sm font-medium text-neutral-800 dark:text-neutral-200 group-hover:text-black dark:group-hover:text-white line-clamp-1 transition-colors">
              {prevPost.title}
            </span>
          </a>
        ) : (
          <div></div>
        )}

        {nextPost && (
          <a
            href={`/blog/${nextPost.id}`}
            class="group p-4 rounded-lg border border-neutral-200 dark:border-neutral-800 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors text-right"
          >
            <span class="text-[10px] font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500 block mb-1">
              Next Post →
            </span>
            <span class="text-sm font-medium text-neutral-800 dark:text-neutral-200 group-hover:text-black dark:group-hover:text-white line-clamp-1 transition-colors">
              {nextPost.title}
            </span>
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>
