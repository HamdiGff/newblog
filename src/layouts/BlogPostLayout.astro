---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SocialShare from '../components/SocialShare.astro';

interface Props {
  title: string;
  description: string;
  game: string;
  category: string;
  status: 'Undetected' | 'Working' | 'Updated' | 'Testing' | 'Free';
  version: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  downloadUrl?: string;
  mirrorUrl?: string;
  archivePassword?: string;
  fileSize?: string;
  scriptCode?: string;
  views: number;
  downloads: number;
  author?: string;
  virusScanScore?: string;
  virusTotalUrl?: string;
  antiCheat?: string;
  platforms?: string[];
  executors?: string[];
  tags?: string[];
  readingTime: string;
  prevPost?: { id: string; title: string };
  nextPost?: { id: string; title: string };
}

const {
  title,
  description,
  game,
  category,
  status,
  version,
  pubDate,
  updatedDate,
  heroImage,
  downloadUrl = '#',
  mirrorUrl,
  archivePassword,
  fileSize = '12.4 MB',
  scriptCode,
  views,
  downloads,
  author = 'CheaterFun Team',
  virusScanScore = '0/68 Clean',
  virusTotalUrl,
  antiCheat,
  platforms = ['Windows 10', 'Windows 11'],
  executors = [],
  tags = [],
  readingTime,
  prevPost,
  nextPost,
} = Astro.props;

const currentUrl = Astro.url.href;

const statusColor = {
  Undetected: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
  Working: 'bg-green-500/10 text-green-400 border-green-500/30',
  Updated: 'bg-amber-500/10 text-amber-400 border-amber-500/30',
  Testing: 'bg-blue-500/10 text-blue-400 border-blue-500/30',
  Free: 'bg-purple-500/10 text-purple-400 border-purple-500/30',
}[status] || 'bg-neutral-800 text-neutral-300 border-neutral-700';
---

<BaseLayout title={title} description={description} image={heroImage} articleDate={pubDate}>
  <div class="max-w-4xl mx-auto space-y-8">
    <!-- Breadcrumb Nav -->
    <nav class="flex items-center gap-2 text-xs font-mono text-neutral-400">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span>/</span>
      <a href={`/game/${game.toLowerCase().replace(/\s+/g, '-')}`} class="hover:text-red-400 transition-colors">
        {game}
      </a>
      <span>/</span>
      <span class="text-neutral-500 truncate max-w-xs">{title}</span>
    </nav>

    <!-- Main Header Card -->
    <header class="p-6 sm:p-8 rounded-2xl border border-neutral-800 bg-[#121217] space-y-6">
      <!-- Top Tags & Status -->
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-2.5 py-1 text-xs font-mono font-bold uppercase rounded border bg-red-500/20 text-red-300 border-red-500/30">
            {game}
          </span>
          <span class="px-2.5 py-1 text-xs font-mono text-neutral-300 bg-neutral-900 rounded border border-neutral-800">
            {category}
          </span>
          <span class="px-2.5 py-1 text-xs font-mono text-neutral-400 bg-neutral-900 rounded border border-neutral-800">
            {version}
          </span>
          {antiCheat && (
            <span class="px-2.5 py-1 text-xs font-mono text-cyan-300 bg-cyan-950/40 rounded border border-cyan-800/40">
              🛡️ {antiCheat}
            </span>
          )}
        </div>

        <!-- Status Indicator -->
        <span class={`inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono font-bold uppercase rounded-full border backdrop-blur-md ${statusColor}`}>
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Status: {status}
        </span>
      </div>

      <!-- Title & Excerpt -->
      <div class="space-y-3">
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-white leading-tight">
          {title}
        </h1>
        <p class="text-sm sm:text-base text-neutral-300 leading-relaxed">
          {description}
        </p>
      </div>

      <!-- Compatibility & Author Row -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-neutral-800/80 text-xs">
        <div class="flex items-center gap-2 text-neutral-400">
          <span class="text-neutral-500">Author:</span>
          <span class="font-bold text-white">{author}</span>
        </div>

        {platforms && platforms.length > 0 && (
          <div class="flex items-center gap-1.5 font-mono text-[11px]">
            <span class="text-neutral-500">OS:</span>
            {platforms.map((p) => (
              <span class="px-2 py-0.5 rounded bg-neutral-900 border border-neutral-800 text-neutral-300">
                {p}
              </span>
            ))}
          </div>
        )}
      </div>

      {executors && executors.length > 0 && (
        <div class="flex items-center gap-2 text-xs font-mono">
          <span class="text-neutral-500">Compatible Executors:</span>
          <div class="flex flex-wrap gap-1.5">
            {executors.map((ex) => (
              <span class="px-2 py-0.5 rounded bg-red-950/30 border border-red-800/40 text-red-300 text-[11px] font-bold">
                ✓ {ex}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 text-xs font-mono">
        <div class="p-3 rounded-xl bg-neutral-900/60 border border-neutral-800">
          <span class="text-neutral-500 block text-[10px] uppercase">Downloads</span>
          <span class="text-white font-bold text-sm">{(downloads / 1000).toFixed(1)}k</span>
        </div>
        <div class="p-3 rounded-xl bg-neutral-900/60 border border-neutral-800">
          <span class="text-neutral-500 block text-[10px] uppercase">Views</span>
          <span class="text-white font-bold text-sm">{(views / 1000).toFixed(1)}k</span>
        </div>
        <div class="p-3 rounded-xl bg-neutral-900/60 border border-neutral-800">
          <span class="text-neutral-500 block text-[10px] uppercase">Updated</span>
          <span class="text-white font-bold text-sm"><FormattedDate date={pubDate} /></span>
        </div>
        <div class="p-3 rounded-xl bg-neutral-900/60 border border-neutral-800">
          <span class="text-neutral-500 block text-[10px] uppercase">Antivirus Status</span>
          {virusTotalUrl ? (
            <a href={virusTotalUrl} target="_blank" rel="noopener noreferrer" class="text-emerald-400 font-bold text-sm hover:underline flex items-center gap-1">
              <span>{virusScanScore}</span>
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          ) : (
            <span class="text-emerald-400 font-bold text-sm">{virusScanScore}</span>
          )}
        </div>
      </div>

      <!-- Prominent Download & Action Box -->
      <div class="p-6 rounded-xl border border-red-950/60 bg-gradient-to-br from-red-950/20 via-neutral-900/40 to-neutral-900 space-y-4">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <div class="font-bold text-white text-base">Direct Download Package</div>
            <div class="text-xs text-neutral-400 flex items-center gap-2 mt-0.5">
              <span>File Size: <strong class="text-neutral-200">{fileSize}</strong></span>
              <span>•</span>
              <span>Direct high-speed CDN</span>
            </div>
            {archivePassword && (
              <div class="mt-2 text-xs font-mono text-amber-300 bg-amber-950/40 px-2.5 py-1 rounded border border-amber-800/40 inline-flex items-center gap-1.5">
                <span>🔐 Archive Password:</span>
                <code class="bg-black/60 px-1.5 py-0.5 rounded font-bold text-white">{archivePassword}</code>
              </div>
            )}
          </div>

          <div class="flex flex-col sm:flex-row items-center gap-2.5 w-full sm:w-auto">
            <a
              href={downloadUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-black uppercase tracking-wider bg-red-600 hover:bg-red-500 text-white shadow-xl shadow-red-950/60 transition-all hover:scale-[1.02]"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/>
              </svg>
              <span>Download (.zip)</span>
            </a>

            {mirrorUrl && (
              <a
                href={mirrorUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-3 rounded-xl text-xs font-bold uppercase tracking-wider bg-neutral-900 hover:bg-neutral-800 text-neutral-300 border border-neutral-800 transition-colors"
              >
                Mirror Link
              </a>
            )}
          </div>
        </div>

        <!-- Raw Script Code copy if present -->
        {scriptCode && (
          <div class="space-y-2 pt-4 border-t border-neutral-800">
            <div class="flex items-center justify-between text-xs font-mono">
              <span class="font-bold text-neutral-300">Raw Roblox Script (Lua):</span>
              <button
                type="button"
                id="copy-script-btn"
                class="px-3 py-1 rounded bg-neutral-800 hover:bg-neutral-700 text-white transition-colors cursor-pointer flex items-center gap-1"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span id="copy-btn-text">Copy Script</span>
              </button>
            </div>
            <pre class="p-3 rounded-lg bg-black text-red-400 font-mono text-xs overflow-x-auto border border-neutral-800"><code>{scriptCode.trim()}</code></pre>
          </div>
        )}
      </div>
    </header>

    <!-- Post Article Body -->
    <div class="p-6 sm:p-8 rounded-2xl border border-neutral-800 bg-[#121217] prose-content">
      <slot />
    </div>

    <!-- Social Share & Post Nav -->
    <div class="space-y-6">
      <SocialShare title={title} url={currentUrl} />

      {(prevPost || nextPost) && (
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-6 border-t border-neutral-800">
          {prevPost ? (
            <a
              href={`/blog/${prevPost.id}`}
              class="group p-4 rounded-xl border border-neutral-800 bg-[#121217] hover:border-neutral-700 transition-colors"
            >
              <span class="text-[10px] font-mono uppercase tracking-wider text-neutral-500 block mb-1">
                ← Previous Release
              </span>
              <span class="text-sm font-bold text-neutral-300 group-hover:text-red-400 line-clamp-1 transition-colors">
                {prevPost.title}
              </span>
            </a>
          ) : (
            <div></div>
          )}

          {nextPost && (
            <a
              href={`/blog/${nextPost.id}`}
              class="group p-4 rounded-xl border border-neutral-800 bg-[#121217] hover:border-neutral-700 transition-colors text-right"
            >
              <span class="text-[10px] font-mono uppercase tracking-wider text-neutral-500 block mb-1">
                Next Release →
              </span>
              <span class="text-sm font-bold text-neutral-300 group-hover:text-red-400 line-clamp-1 transition-colors">
                {nextPost.title}
              </span>
            </a>
          )}
        </nav>
      )}
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const copyBtn = document.getElementById('copy-script-btn');
  const copyBtnText = document.getElementById('copy-btn-text');
  const scriptCodeElem = document.querySelector('pre code');

  copyBtn?.addEventListener('click', async () => {
    if (!scriptCodeElem) return;
    try {
      await navigator.clipboard.writeText(scriptCodeElem.textContent || '');
      if (copyBtnText) {
        copyBtnText.textContent = 'Copied!';
        setTimeout(() => {
          copyBtnText.textContent = 'Copy Script';
        }, 2000);
      }
    } catch (err) {
      console.error('Failed to copy script', err);
    }
  });
</script>
