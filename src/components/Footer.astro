---
import { SITE } from '../utils/seo';
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-950/50 py-10 transition-colors">
  <div class="max-w-4xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500 dark:text-neutral-400">
    <!-- Brand / Status -->
    <div class="flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="font-mono">All systems operational</span>
      <span class="text-neutral-300 dark:text-neutral-700">•</span>
      <span>© {currentYear} {SITE.title}</span>
    </div>

    <!-- Links -->
    <div class="flex items-center gap-4 font-mono">
      <a
        href="/rss.xml"
        class="hover:text-neutral-900 dark:hover:text-white transition-colors flex items-center gap-1"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
        RSS
      </a>
      <a
        href="/sitemap-index.xml"
        class="hover:text-neutral-900 dark:hover:text-white transition-colors"
      >
        Sitemap
      </a>
      <a
        href="https://vercel.com"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-neutral-900 dark:hover:text-white transition-colors flex items-center gap-1"
      >
        <span>Vercel</span>
        <svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 24 24">
          <path d="M12 4L20 18H4L12 4Z" />
        </svg>
      </a>
    </div>
  </div>
</footer>
