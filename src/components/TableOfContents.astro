---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth > 1 && h.depth < 4);
---

{filteredHeadings.length > 0 && (
  <nav class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/30 my-6">
    <div class="text-xs font-mono uppercase tracking-wider text-neutral-500 dark:text-neutral-400 mb-2.5 font-semibold">
      On this page
    </div>
    <ul class="space-y-1.5 text-sm">
      {filteredHeadings.map((heading) => (
        <li style={`padding-left: ${(heading.depth - 2) * 0.75}rem`}>
          <a
            href={`#${heading.slug}`}
            class="text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white transition-colors block py-0.5"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
