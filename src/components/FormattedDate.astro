---
interface Props {
  date: Date;
  className?: string;
}

const { date, className = '' } = Astro.props;
---

<time datetime={date.toISOString()} class={`font-mono text-xs text-neutral-500 dark:text-neutral-400 ${className}`}>
  {
    date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  }
</time>
