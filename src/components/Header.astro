---
import { SITE } from '../utils/seo';

const pathname = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'All Cheats' },
  { href: '/game/roblox', label: 'Roblox Scripts' },
  { href: '/game/counter-strike-2', label: 'CS2 Hacks' },
  { href: '/game/gta-v', label: 'GTA V / FiveM' },
  { href: '/category/injectors', label: 'Executors & Tools' },
];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-neutral-950/90 border-b border-neutral-800 transition-colors">
  <!-- Top Utility Bar -->
  <div class="bg-neutral-900/60 border-b border-neutral-800/80 text-[11px] text-neutral-400 py-1 px-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 text-emerald-400 font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          All Cheats Tested & Working
        </span>
        <span class="hidden sm:inline text-neutral-600">|</span>
        <span class="hidden sm:inline text-neutral-400">Daily Updates • No Surveys • Direct Downloads</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="https://discord.gg" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-1">
          <span class="text-indigo-400">Discord</span> (24k)
        </a>
        <a href="https://t.me" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-1">
          <span class="text-sky-400">Telegram</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between gap-4">
    <!-- Brand / Logo -->
    <a href="/" class="flex items-center gap-2 group shrink-0">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-red-600 to-red-800 flex items-center justify-center text-white shadow-lg shadow-red-900/40 group-hover:scale-105 transition-transform">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-10 7H8v3H6v-3H3v-2h3V8h2v3h3v2zm4.5 2c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm4-3c-.83 0-1.5-.67-1.5-1.5S18.67 9 19.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
        </svg>
      </div>
      <span class="text-xl font-black tracking-tight text-white uppercase">
        CHEATER<span class="text-red-500">.FUN</span>
      </span>
    </a>

    <!-- Nav Items -->
    <nav class="hidden lg:flex items-center gap-1 text-xs font-semibold tracking-wide uppercase">
      {navItems.map((item) => {
        const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-3 py-1.5 rounded-md transition-all ${
              isActive
                ? 'bg-neutral-800 text-white border border-neutral-700 shadow-sm'
                : 'text-neutral-400 hover:text-white hover:bg-neutral-900'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3">
      <!-- Search Trigger / Input -->
      <a
        href="/#search-section"
        class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-neutral-800 bg-neutral-900/80 text-xs font-mono text-neutral-400 hover:text-white hover:border-neutral-700 transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span>Search hacks...</span>
        <kbd class="text-[10px] bg-neutral-800 text-neutral-400 px-1 rounded border border-neutral-700">/</kbd>
      </a>

      <!-- Discord CTA Button -->
      <a
        href="https://discord.gg"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-bold uppercase tracking-wider bg-red-600 hover:bg-red-500 text-white shadow-md shadow-red-950/50 transition-all hover:scale-[1.02]"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
        </svg>
        <span>Join Discord</span>
      </a>
    </div>
  </div>
</header>
