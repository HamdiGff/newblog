---
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      game: string;
      category: string;
      status: 'Undetected' | 'Working' | 'Updated' | 'Testing' | 'Free';
      version: string;
      pubDate: Date;
      thumbnail?: string;
      views: number;
      downloads: number;
      tags: string[];
      featured?: boolean;
    };
  };
}

const { post } = Astro.props;

const statusColor = {
  Undetected: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
  Working: 'bg-green-500/10 text-green-400 border-green-500/30',
  Updated: 'bg-amber-500/10 text-amber-400 border-amber-500/30',
  Testing: 'bg-blue-500/10 text-blue-400 border-blue-500/30',
  Free: 'bg-purple-500/10 text-purple-400 border-purple-500/30',
}[post.data.status] || 'bg-neutral-800 text-neutral-300 border-neutral-700';

const gameTagColor: Record<string, string> = {
  Roblox: 'bg-red-500/20 text-red-300 border-red-500/30',
  'Counter-Strike 2': 'bg-amber-500/20 text-amber-300 border-amber-500/30',
  'GTA V': 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30',
  FiveM: 'bg-orange-500/20 text-orange-300 border-orange-500/30',
  Valorant: 'bg-rose-500/20 text-rose-300 border-rose-500/30',
};

const gameBadge = gameTagColor[post.data.game] || 'bg-neutral-800 text-neutral-300 border-neutral-700';
---

<article class="group relative rounded-xl border border-neutral-800 bg-[#121216] overflow-hidden hover:border-neutral-700 transition-all duration-200 hover:shadow-xl hover:shadow-red-950/20 flex flex-col">
  <!-- Card Banner / Image -->
  <div class="relative w-full h-44 sm:h-48 overflow-hidden bg-neutral-900">
    {post.data.thumbnail ? (
      <img
        src={post.data.thumbnail}
        alt={post.data.title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-neutral-900 to-neutral-950 text-neutral-700 font-bold text-2xl">
        CHEATER.FUN
      </div>
    )}

    <!-- Gradient overlay for readability -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#121216] via-transparent to-black/60"></div>

    <!-- Top Floating Badges -->
    <div class="absolute top-3 left-3 flex items-center gap-1.5 z-10">
      <span class={`px-2 py-0.5 text-[11px] font-mono font-bold uppercase rounded border ${gameBadge}`}>
        {post.data.game}
      </span>
      <span class="px-2 py-0.5 text-[11px] font-mono text-neutral-400 bg-black/60 rounded border border-neutral-800 backdrop-blur-sm">
        {post.data.version}
      </span>
    </div>

    <!-- Top Right Status Badge -->
    <div class="absolute top-3 right-3 z-10">
      <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 text-[11px] font-mono font-bold uppercase rounded-full border backdrop-blur-md ${statusColor}`}>
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        {post.data.status}
      </span>
    </div>
  </div>

  <!-- Content Body -->
  <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between gap-3">
    <div class="space-y-2">
      <!-- Title -->
      <h2 class="text-base sm:text-lg font-bold tracking-tight text-white group-hover:text-red-400 transition-colors line-clamp-2">
        <a href={`/blog/${post.id}`} class="after:absolute after:inset-0">
          {post.data.title}
        </a>
      </h2>

      <!-- Description -->
      <p class="text-xs text-neutral-400 line-clamp-2 leading-relaxed">
        {post.data.description}
      </p>
    </div>

    <!-- Metadata Footer Bar -->
    <div class="pt-3 border-t border-neutral-800/80 flex items-center justify-between text-[11px] font-mono text-neutral-400">
      <div class="flex items-center gap-3">
        <!-- Views -->
        <span class="flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          {(post.data.views / 1000).toFixed(1)}k
        </span>

        <!-- Downloads -->
        <span class="flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          {(post.data.downloads / 1000).toFixed(1)}k
        </span>

        <!-- Date -->
        <FormattedDate date={post.data.pubDate} className="hidden sm:inline" />
      </div>

      <!-- Button CTA -->
      <span class="inline-flex items-center gap-1 font-bold text-red-400 group-hover:text-red-300 transition-colors">
        <span>Get Cheat</span>
        <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    </div>
  </div>
</article>
