---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../utils/seo';

const faqs = [
  {
    q: 'Are all cheats and scripts on CHEATER.FUN free?',
    a: 'Yes, 100% of our cheats, trainers, and script hubs are available with direct downloads and zero hidden paywalls.',
  },
  {
    q: 'How do I bypass Antivirus False Positives?',
    a: 'Because injectors write into game process memory (e.g., VirtualAllocEx), Windows Defender often flags them. Add your cheat folder to the Windows Defender Exclusion list.',
  },
  {
    q: 'How often are Roblox scripts and game hacks updated?',
    a: 'Whenever a game pushes an anti-cheat or content patch, our contributors test and update the releases within 24 to 48 hours.',
  },
  {
    q: 'How do I use Roblox scripts?',
    a: 'You need a working script executor (such as Solara, Codex, or Delta). Open your game, paste the script code from our post into the executor, and press Inject/Execute.',
  },
];
---

<BaseLayout title="About & FAQ — CHEATER.FUN" description="Frequently asked questions and guides about game cheats, scripts, and downloads.">
  <div class="max-w-3xl mx-auto space-y-10">
    <header class="p-6 sm:p-8 rounded-2xl border border-neutral-800 bg-[#121217] space-y-3">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase text-red-500">
        About The Project
      </div>
      <h1 class="text-3xl font-black text-white uppercase tracking-tight">
        Welcome to CHEATER.FUN
      </h1>
      <p class="text-sm text-neutral-400 leading-relaxed">
        CHEATER.FUN is an open community platform dedicated to sharing working game modifications, trainers, Roblox Lua scripts, and memory manipulation utilities.
      </p>
    </header>

    <!-- FAQ Section -->
    <section class="space-y-4">
      <h2 class="text-sm font-mono font-bold uppercase tracking-wider text-white flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-red-500"></span>
        Frequently Asked Questions (FAQ)
      </h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <div class="p-5 rounded-xl border border-neutral-800 bg-[#121217] space-y-2">
            <h3 class="text-sm font-bold text-white">
              {faq.q}
            </h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Support and Contact -->
    <section class="p-6 rounded-2xl border border-neutral-800 bg-[#121217] flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <div class="text-sm font-bold text-white">Need help with an injector or script?</div>
        <div class="text-xs text-neutral-400">Join 24,000+ members in our official Discord community for live assistance.</div>
      </div>
      <a
        href="https://discord.gg"
        target="_blank"
        rel="noopener noreferrer"
        class="px-5 py-2.5 rounded-xl bg-red-600 hover:bg-red-500 text-white font-bold text-xs uppercase tracking-wider transition-colors shrink-0"
      >
        Join Discord Server
      </a>
    </section>
  </div>
</BaseLayout>
