---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
export const prerender = true;
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const categoriesMap = new Map<string, typeof allPosts>();

  allPosts.forEach((post) => {
    const slug = post.data.category.toLowerCase().replace(/\s+/g, '-');
    if (!categoriesMap.has(slug)) {
      categoriesMap.set(slug, []);
    }
    categoriesMap.get(slug)!.push(post);
  });

  return Array.from(categoriesMap.entries()).map(([slug, posts]) => {
    const originalCategory = posts[0].data.category;
    posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return {
      params: { category: slug },
      props: { category: originalCategory, posts },
    };
  });
}

const { category, posts } = Astro.props;
---

<BaseLayout
  title={`${category} — Game Tools & Downloads — CHEATER.FUN`}
  description={`Download free undetected ${category} and software utilities.`}
>
  <div class="space-y-6">
    <!-- Header -->
    <header class="p-6 rounded-2xl border border-neutral-800 bg-[#121217] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="space-y-1">
        <div class="inline-flex items-center gap-2 text-xs font-mono text-red-400 font-bold uppercase">
          <a href="/" class="hover:underline">Home</a>
          <span>/</span>
          <span>Category</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight uppercase">
          {category}
        </h1>
        <p class="text-xs text-neutral-400">
          Showing {posts.length} utilities and downloads.
        </p>
      </div>

      <a
        href="/"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-neutral-800 bg-neutral-900 text-xs font-mono text-neutral-300 hover:text-white transition-colors shrink-0"
      >
        ← Return Home
      </a>
    </header>

    <!-- Post list -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {posts.map((post) => (
        <BlogPostCard post={post} />
      ))}
    </div>
  </div>
</BaseLayout>
