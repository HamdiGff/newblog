---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { calculateReadingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: index < posts.length - 1 ? { id: posts[index + 1].id, title: posts[index + 1].data.title } : undefined,
      nextPost: index > 0 ? { id: posts[index - 1].id, title: posts[index - 1].data.title } : undefined,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
const readingTime = calculateReadingTime(post.body || '');
---

<BlogPostLayout
  title={post.data.title}
  description={post.data.description}
  game={post.data.game}
  category={post.data.category}
  status={post.data.status}
  version={post.data.version}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  heroImage={post.data.thumbnail}
  downloadUrl={post.data.downloadUrl}
  scriptCode={post.data.scriptCode}
  views={post.data.views}
  downloads={post.data.downloads}
  tags={post.data.tags}
  readingTime={readingTime.text}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content />
</BlogPostLayout>
