---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="All Cheats & Scripts Archive — CHEATER.FUN" description="Browse all available game hacks, Roblox scripts, and mod menus.">
  <div class="space-y-6">
    <header class="p-6 rounded-2xl border border-neutral-800 bg-[#121217] space-y-2">
      <h1 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight">
        All Game Cheats & Scripts Archive
      </h1>
      <p class="text-xs text-neutral-400">
        Showing all {allPosts.length} releases sorted by release date.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {allPosts.map((post) => (
        <BlogPostCard post={post} />
      ))}
    </div>
  </div>
</BaseLayout>
